{
  "version": "4.0.1",
  "name": "EnOceanBleDevices",
  "description": "Implementation of EnOcean Selfpowered BLE devices",
  "keywords": "EnOcean PTM215b PTM535BZ EMDCB STM550B esp32 BLE",
  "authors": [
    {
      "name": "Jeroen van de Vorst",
      "maintainer": true,
      "url": "https://I-Connect.online"
    },
    {
      "name": "Bas Schouten"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/I-Connect/EnOceanBleDevices.git"
  },
  "frameworks": "Arduino",
  "platforms": [
    "espressif32"
  ],
  "build": {
    "flags": "-Wno-unused-function",
    "srcFilter": [
      "+<*>",
      "-<examples/*>",
      "-<main.cpp>"
    ]
  },
  "dependencies": [
    {
      "name": "BleScanner",
      "version": "https://github.com/I-Connect/BleScanner"
    }
  ]
}